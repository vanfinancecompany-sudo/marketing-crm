{
  "crons": [
    {
      "path": "/api/vansco-cache-live-refresh?auto=true&batchSize=15&maxMs=45000",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/marketing-template-campaign-send-orphan-worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/marketing-template-campaign-send-worker",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/buffer-facebook-automation-cron",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/buffer-instagram-mirror",
      "schedule": "14 * * * *"
    },
    {
      "path": "/api/marketing-editorial-automation-worker",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/buffer-facebook-story-automation",
      "schedule": "25 * * * *"
    },
    {
      "path": "/api/rent2buy-monthly-price-sync",
      "schedule": "23 * * * *"
    },
    {
      "path": "/api/buffer-publish-status",
      "schedule": "35 * * * *"
    },
    {
      "path": "/api/carslink-auto-sync",
      "schedule": "47 * * * *"
    }
  ],
  "functions": {
    "api/buffer-facebook-automation-worker.js": {
      "maxDuration": 300
    },
    "api/buffer-facebook-automation-cron.js": {
      "maxDuration": 300
    },
    "api/buffer-facebook-story-automation.js": {
      "maxDuration": 120
    },
    "api/buffer-instagram-mirror.js": {
      "maxDuration": 120
    },
    "api/marketing-editorial-automation-worker.js": {
      "maxDuration": 300
    },
    "api/marketing-template-campaign-sends-resilient.js": {
      "maxDuration": 300
    },
    "api/marketing-template-campaign-sends-hardened.js": {
      "maxDuration": 300
    },
    "api/marketing-template-campaign-sends-router.js": {
      "maxDuration": 300
    },
    "api/marketing-template-campaign-send-orphan-worker.js": {
      "maxDuration": 60
    },
    "api/marketing-template-campaign-send-worker.js": {
      "maxDuration": 300
    },
    "api/marketing-website-index-discovery.js": {
      "maxDuration": 300
    },
    "api/marketing-ai-visibility.js": {
      "maxDuration": 15
    },
    "api/marketing-ai-visibility-google.js": {
      "maxDuration": 300
    },
    "api/carslink-auto-sync.js": {
      "maxDuration": 300
    },
    "api/carslink-production-test.js": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/wix-ai-assistant/embed.html",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://vanfinancecompany.co.uk https://www.vanfinancecompany.co.uk https://rent2buyvans.co.uk https://www.rent2buyvans.co.uk https://editor.wix.com https://manage.wix.com https://www.wix.com https://*.wixsite.com"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/marketing-template-campaign-sends", "destination": "/api/marketing-template-campaign-sends-resilient" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
