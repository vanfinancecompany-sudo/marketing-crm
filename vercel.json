{
  "crons": [
    {
      "path": "/api/vansco-cache-live-refresh?auto=true&batchSize=15&maxMs=45000",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/marketing-editorial-automation-worker",
      "schedule": "17 * * * *"
    }
  ],
  "functions": {
    "api/marketing-editorial-automation-worker.js": {
      "maxDuration": 300
    },
    "api/marketing-website-index-discovery.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
