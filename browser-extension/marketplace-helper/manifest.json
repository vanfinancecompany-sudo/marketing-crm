{
  "manifest_version": 3,
  "name": "VFC Facebook Helper",
  "version": "1.2.4",
  "description": "Controlled Facebook Marketplace and Groups helper for Van Finance Company and Rent2Buy Vans. Never publishes automatically.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://marketing-crm-six.vercel.app/*",
    "https://*.vercel.app/*",
    "https://www.facebook.com/*",
    "https://static.wixstatic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://marketing-crm-six.vercel.app/*", "https://*.vercel.app/*"],
      "js": ["crm-bridge.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/marketplace/create/vehicle*"],
      "js": ["facebook.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/groups/*",
        "https://www.facebook.com/search/groups/*"
      ],
      "js": ["facebook-groups.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "VFC Facebook Helper"
  }
}
