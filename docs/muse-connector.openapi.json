      "get": {
        "operationId": "getAskMe",
        "summary": "Ask Me assistant engagement analytics",
        "description": "Ask Me assistant engagement analytics. Read-only. Aggregated or redacted: no customer names, contact details, addresses, application or finance details, or conversation text.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "description": "Look-back window in days (1-90).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong key"
          },
          "429": {
            "description": "Rate limited (60/min)"
          }
        }
      }
    },
    "/api/muse/conversations": {
      "get": {
        "operationId": "getConversations",
        "summary": "Enquiry volumes by channel, product and day",
        "description": "Enquiry volumes by channel, product and day. Read-only. Aggregated or redacted: no customer names, contact details, addresses, application or finance details, or conversation text.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "description": "Look-back window in days (1-90).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
