      }
    },
    "/api/muse/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "summary": "Marketing CRM capabilities",
        "description": "Marketing CRM capabilities. Read-only. Aggregated or redacted: no customer names, contact details, addresses, application or finance details, or conversation text.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong key"
          },
          "429": {
            "description": "Rate limited (60/min)"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "museKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-muse-api-key"
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "properties": {
          "resource": {
            "type": "string"
          },
          "generatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "readOnly": {
            "type": "boolean"
          },
          "data": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
