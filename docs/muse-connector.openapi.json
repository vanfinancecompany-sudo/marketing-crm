      "get": {
        "operationId": "getOpportunities",
        "summary": "Customer demand themes and content gaps",
        "description": "Customer demand themes and content gaps. Read-only. Aggregated or redacted: no customer names, contact details, addresses, application or finance details, or conversation text.",
        "parameters": [
          {
            "name": "product",
            "in": "query",
            "required": false,
            "description": "Filter by product.",
            "schema": {
              "type": "string",
              "enum": [
                "finance",
                "rent2buy"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum items (1-200, default 50).",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong key"
          },
          "429": {
            "description": "Rate limited (60/min)"
          }
        }
      }
    },
    "/api/muse/campaigns": {
      "get": {
        "operationId": "getCampaigns",
        "summary": "Campaigns and email send totals",
        "description": "Campaigns and email send totals. Read-only. Aggregated or redacted: no customer names, contact details, addresses, application or finance details, or conversation text.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum items (1-200, default 50).",
            "schema": {
