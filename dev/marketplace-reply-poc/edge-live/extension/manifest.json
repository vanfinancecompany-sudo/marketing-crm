{
  "manifest_version": 3,
  "name": "Rent2Buy Marketplace Assistant (development)",
  "version": "0.3.23",
  "description": "Answers basic Rent2Buy Marketplace enquiries from a dedicated background tab using the website Ask Me engine. Off by default; local control at http://127.0.0.1:4618/.",
  "permissions": ["tabs", "storage", "alarms", "idle"],
  "host_permissions": ["https://www.facebook.com/*", "http://127.0.0.1:4618/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "http://127.0.0.1:4618/__fb/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Marketplace Assistant", "default_popup": "popup.html" },
  "commands": {
    "emergency-stop": {
      "suggested_key": { "default": "Alt+Shift+0" },
      "description": "Stop the Marketplace assistant immediately"
    }
  }
}
